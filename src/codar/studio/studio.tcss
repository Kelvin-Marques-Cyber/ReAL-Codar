/* Codar Studio — paleta "mission control" (fundo $codar-bg, âmbar, molduras laranja, rótulos vermelhos, dados menta) */

Screen {
    background: $codar-bg;
    color: $codar-text;
}

/* todas as barras de rolagem (cada widget tem a sua; regra só no Screen não chega nelas) */
* {
    scrollbar-color: $codar-sel;
    scrollbar-color-hover: $codar-line;
    scrollbar-color-active: $codar-text;
    scrollbar-background: $codar-bg;
    scrollbar-background-hover: $codar-bg;
    scrollbar-background-active: $codar-bg;
    scrollbar-corner-color: $codar-bg;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* pílulas clicáveis (S0, S1, AUDIT…): a cor vem do texto, sem o sublinhado padrão de link */
#pills, #lang-pill {
    link-color: $codar-text;
    link-background: $codar-bg;
    link-style: none;
    link-color-hover: $codar-bg;
    link-background-hover: $codar-mint;
    link-style-hover: bold;
}

#workspace {
    height: 1fr;
}

#left {
    width: 32;
}

#center {
    width: 1fr;
}

#right {
    width: 38;
}

#explorer, #radar, #feed, #editors, #panel, #last-card, #telemetry, #history, #intent-bar {
    border: round $codar-orange;
    border-title-color: $codar-red;
    border-title-style: bold;
    border-title-background: $codar-bg;
    border-subtitle-color: $codar-dim;
    background: $codar-bg;
}

#explorer:focus-within, #editors:focus-within, #panel:focus-within, #intent-bar:focus-within {
    border: round $codar-mint;
}

#explorer {
    height: 1fr;
    color: $codar-green;
}

#radar {
    height: 11;
}

#feed {
    height: 14;
    padding: 0 1;
}

#pills-bar {
    height: 1;
    padding: 0 1;
}

#pills {
    width: 1fr;
}

#lang-pill {
    width: auto;
}

#editors {
    height: 1fr;
}

#panel {
    height: 14;
}

#hud-title {
    color: $codar-mint;
    text-style: bold;
    padding: 1 1 0 1;
    height: 4;
}

#hud-meta {
    height: 4;
    padding: 0 1;
}

#last-card {
    height: 10;
    padding: 0 1;
}

#telemetry {
    height: 11;
    padding: 0 1;
}

#history {
    height: 1fr;
}

#intent-bar {
    height: 3;
}

#intent-label {
    width: 13;
    color: $codar-red;
    text-style: bold;
    padding: 0 1;
    content-align: left middle;
}

#status {
    height: 1;
    background: $codar-panel;
}

Input {
    background: $codar-bg;
    color: $codar-mint;
    border: none;
    height: 1;
    padding: 0 1;
}

Input:focus {
    border: none;
    background: $codar-grid;
}

Input > .input--placeholder {
    color: $codar-dim;
}

#term-log, #output {
    height: 1fr;
    padding: 0 1;
    background: $codar-bg;
}

#term-input {
    dock: bottom;
}

DirectoryTree {
    background: $codar-bg;
}

DirectoryTree > .directory-tree--folder {
    color: $codar-text;
    text-style: bold;
}

DirectoryTree > .directory-tree--file {
    color: $codar-green;
}

DirectoryTree > .directory-tree--extension {
    color: $codar-dim;
    text-style: none;
}

DirectoryTree > .directory-tree--hidden {
    color: $codar-dim;
}

DirectoryTree > .tree--guides {
    color: $codar-line;
}

DirectoryTree > .tree--guides-hover, DirectoryTree > .tree--guides-selected {
    color: $codar-orange;
}

DirectoryTree > .tree--cursor {
    background: $codar-sel;
    color: $codar-mint;
    text-style: bold;
}

DirectoryTree:focus > .tree--cursor {
    background: $codar-orange;
    color: $codar-bg;
}

DirectoryTree > .tree--highlight-line {
    background: $codar-grid;
}

/* paleta de comandos (Ctrl+P) */
CommandPalette > .command-palette--help-text {
    color: $codar-dim;
}

CommandPalette > .command-palette--highlight {
    color: $codar-mint;
    text-style: bold;
}

CommandPalette #--input {
    border: round $codar-orange;
    background: $codar-bg;
}

CommandPalette #--results {
    background: $codar-bg;
}

Tooltip {
    background: $codar-panel;
    color: $codar-text;
    border: round $codar-line;
}

DataTable {
    background: $codar-bg;
    color: $codar-green;
}

DataTable > .datatable--header {
    background: $codar-grid;
    color: $codar-red;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $codar-sel;
    color: $codar-mint;
}

Tabs {
    background: $codar-bg;
}

Tab {
    color: $codar-dim;
}

Tab.-active {
    color: $codar-red;
    text-style: bold;
}

Tab:hover {
    color: $codar-text;
}

Underline > .underline--bar {
    color: $codar-orange;
    background: $codar-grid;
}

ListView {
    background: $codar-bg;
}

ListItem {
    background: $codar-bg;
    padding: 0 1;
}

ListItem.-highlight, ListView > ListItem.-highlight {
    background: $codar-grid;
}

#advice-list > ListItem {
    border-bottom: dashed $codar-line;
}

TextArea {
    background: $codar-bg;
    border: none;
}

Footer {
    background: $codar-panel;
    color: $codar-text;
}

FooterKey .footer-key--key {
    color: $codar-mint;
    background: $codar-grid;
}

FooterKey .footer-key--description {
    color: $codar-text;
}

AdviceScreen, PromptScreen {
    align: center middle;
    background: $codar-bg 75%;
}

#advice-card {
    width: 96;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    border: round $codar-orange;
    border-title-color: $codar-red;
    background: $codar-bg;
    padding: 1 2;
}

#advice-title {
    color: $codar-red;
    text-style: bold;
}

#advice-reason {
    color: $codar-text;
    margin: 1 0;
}

#advice-options {
    height: auto;
    max-height: 18;
}

.advice-plan {
    border-left: thick $codar-line;
    padding: 0 1;
    margin: 0 0 1 0;
}

#advice-buttons {
    height: 3;
    align: right middle;
}

Button {
    background: $codar-bg;
    min-width: 12;
    margin: 0 1;
}

Button.accept {
    color: $codar-mint;
    border: round $codar-mint;
}

Button.accept:hover {
    background: $codar-grid;
}

Button.reject {
    color: $codar-red;
    border: round $codar-red;
}

#prompt-card {
    width: 70;
    height: 7;
    border: round $codar-orange;
    background: $codar-bg;
    padding: 1 2;
}

#prompt-title {
    color: $codar-red;
    text-style: bold;
}

#prompt-input {
    border: round $codar-line;
    height: 3;
}

Toast {
    background: $codar-panel;
    color: $codar-text;
    border-left: outer $codar-orange;
}

Toast.-error {
    border-left: outer $codar-red;
}

/* ---------------------------------------------------------------- ajuda (F1) */
HelpScreen {
    align: center middle;
    background: $codar-bg 70%;
}

#help-card {
    width: 92;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: round $codar-orange;
    border-title-color: $codar-red;
    border-title-style: bold;
    border-subtitle-color: $codar-dim;
    background: $codar-bg;
    padding: 1 2;
}

#help-body {
    height: auto;
    max-height: 100%;
}

.help-group {
    margin-top: 1;
}

.help-items {
    color: $codar-text;
}

/* ---------------------------------------------------------------- boas-vindas (sem arquivo aberto) */
#welcome {
    height: 1fr;
    content-align: center middle;
    text-align: center;
    border: round $codar-orange;
    border-title-color: $codar-red;
    border-title-style: bold;
    background: $codar-bg;
}
