#!/bin/sh
set -e
# Gera os .pyc com o Python do sistema: o codar abre mais rápido e nada é gravado em /usr depois.
if [ "$1" = configure ]; then
    for py in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
        if command -v "$py" >/dev/null 2>&1; then
            "$py" -m compileall -q -j 0 /usr/lib/codar >/dev/null 2>&1 || true
            break
        fi
    done
fi

#DEBHELPER#

exit 0
